@model FrontendQuickpass.Models.AutorizacionIngresoModel
@{
    ViewData["Title"] = "Reportes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/reportes.css" />
}

<!-- Banner y pestañas -->
<div class="banner-wrapper">
<!-- Banner Izquierdo -->
    <section class="custom-banner">
        <h1>Reportes Quickpass</h1>
    </section>
</div>

<div class="filters-container flex items-end gap-4 mt-6 mx-10">
    <!-- Reporte -->
    <div class="filter-item">
        <label for="f-reporte" class="block font-semibold mb-2">Reporte</label>
        <select id="f-reporte" class="w-full h-11 px-3 border border-gray-300 rounded-xl">
            <option value="">Seleccione</option>
            <option value="1">Recepciones</option>
        </select>
    </div>

    <!-- Ingenio -->
    <div class="filter-item">
        <label for="f-ingenio" class="block font-semibold mb-2">Cliente</label>
        <select id="f-ingenio" class="w-full h-11 px-3 border border-gray-300 rounded-xl">
            <option value="">Todos</option>
        </select>
    </div>

    <!-- Producto -->
    <div class="filter-item">
        <label for="f-producto" class="block font-semibold mb-2">Producto</label>
        <select id="f-producto" class="w-full h-11 px-3 border border-gray-300 rounded-xl">
            <option value="">Todos</option>
        </select>
    </div>

    <!-- Punto de almacenaje (solo visible para Recepciones) -->
    <div id="punto-almacenaje-container" class="filter-item hidden">
        <label for="f-punto-almacenaje" class="block font-semibold mb-2">Almacén</label>
        <select id="f-punto-almacenaje" class="w-full h-11 px-3 border border-gray-300 rounded-xl">
            <option value="">Todos</option>
        </select>
    </div>

    <!-- Fecha -->
    <div class="filter-item filters-date">
        <label class="block font-semibold mb-2">Fecha</label>
        <div class="date-range-wrapper">
            <input type="date" id="f-desde" class="date-input">
            <span class="date-separator">–</span>
            <input type="date" id="f-hasta" class="date-input">
        </div>
    </div>

    <!-- Botón en la misma fila -->
    <div class="filter-btn">
        <button id="btn-generar"
                class="h-11 px-5 rounded-xl text-white bg-[#FD6104] hover:opacity-90 active:opacity-80 flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
            <span id="btn-text">Buscar</span>
        </button>
    </div>
</div>

<!-- Estado del reporte -->
<div id="reportes-estado" class="reportes-estado">
    <div class="estado-content">
        <i class="fas fa-filter estado-icon"></i>
        <p class="estado-texto">Completa los filtros y presiona Buscar para ver los resultados</p>
    </div>
</div>

<!-- 
<div id="toolbar" class="toolbar hidden">
  <div class="muted"></div>
  <input type="search" id="f-busqueda" placeholder="Buscar…" />
</div>
-->

<!-- Contenedor Card que integra header + tabla -->
<section id="result">
    <div id="resumen-container" class="table-card hidden">
        <!-- Header de la card -->
        <div class="table-card__header">
            <div class="table-card__title-group">
                <span class="table-card__accent"></span>
                <h3 id="report-title" class="table-card__heading">RECEPCIONES</h3>
            </div>
        </div>
        <!-- Totales del reporte (oculto hasta que haya datos) -->
        <div id="totales-section" class="totales-section hidden">
            <div class="totales-title">
                <h4>Totales:</h4>
            </div>
            <div class="totales-row">
                <div class="totales-container">
                    <div class="total-item">
                        <span class="total-label">Peso Bruto Almapac</span>
                        <span id="total-peso-bruto" class="total-value">0 KG</span>
                    </div>
                    <div class="total-item">
                        <span class="total-label">Peso Tara Almapac</span>
                        <span id="total-peso-tara" class="total-value">0 KG</span>
                    </div>
                    <div class="total-item">
                        <span class="total-label">Peso Neto Almapac</span>
                        <span id="total-peso-neto" class="total-value">0 KG</span>
                    </div>
                </div>
                <section id="exports" class="table-card__actions">
                    <button id="btn-pdf" class="btn-pdf hidden" disabled>Descargar PDF</button>
                    <button id="btn-excel" class="btn-excel" disabled>
                        <svg class="btn-excel__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm-1 2l5 5h-5V4zM8.5 19l2.5-4-2.5-4h1.7l1.8 3 1.8-3h1.7l-2.5 4 2.5 4h-1.7l-1.8-3-1.8 3H8.5z"/>
                        </svg>
                        Descargar Excel
                    </button>
                </section>
            </div>
        </div>
        <!-- Body de la card (tabla) -->
        <div class="table-card__body">
            <div class="table-wrapper">
                <table id="tabla" class="tabla">
                    <thead id="thead"></thead>
                    <tbody id="tbody"></tbody>
                </table>
            </div>
        </div>
    </div>
    <!-- Paginación (se llena desde reportes.js, oculta hasta que haya datos) -->
    <div id="pager" class="hidden"></div>
</section>

@section Scripts
{
    <script src="~/js/reportes.js"></script>
}