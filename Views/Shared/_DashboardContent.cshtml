@* Views/Dashboard/_DashboardContent.cshtml *@
<div class="dash-wrapper">

  <!-- KPIs -->
  <section class="kpi-section">
    <div class="kpi-groups-row">
      <div class="kpi-group-grid">
        <div class="kpi">
          <div class="kpi-value" id="kpi-en-transito">0</div>
          <div class="kpi-label">Camiones En Tránsito</div>
        </div>
        <div class="kpi">
          <div class="kpi-value" id="kpi-en-parqueo">0</div>
          <div class="kpi-label">Camiones en Parqueo</div>
        </div>
        <div class="kpi">
          <div class="kpi-value" id="kpi-autorizados">0</div>
          <div class="kpi-label">Camiones Autorizados</div>
        </div>
      </div>
      <div class="kpi-group-grid">
        <div class="kpi">
          <div class="kpi-value" id="kpi-tiempo-espera">00 h 00 min</div>
          <div class="kpi-label">Tiempo Promedio de Espera</div>
        </div>
        <div class="kpi">
          <div class="kpi-value" id="kpi-tiempo-atencion">00 h 00 min</div>
          <div class="kpi-label">Tiempo Promedio de Atención</div>
        </div>
      </div>
      <div class="kpi-group-grid">
        <div class="kpi">
          <div class="kpi-value" id="kpi-flujo-dia_Az">0 t</div>
          <div class="kpi-label">Flujo Por Día (Azúcar)</div>
        </div>
        <div class="kpi">
          <div class="kpi-value" id="kpi-flujo-dia_Mel">0 t</div>
          <div class="kpi-label">Flujo Por Día (Melaza)</div>
        </div>
      </div>
      <div class="kpi-group-grid">
        <div class="kpi">
          <div class="kpi-value" id="kpi-prom-planas">0 min 00 s</div>
          <div class="kpi-label">Prom. Descarga (Planas)</div>
        </div>
        <div class="kpi">
          <div class="kpi-value" id="kpi-prom-volteo">0 min 00 s</div>
          <div class="kpi-label">Prom. Descarga (Volteo)</div>
        </div>
        <div class="kpi">
          <div class="kpi-value" id="kpi-prom-pipa">0 min 00 s</div>
          <div class="kpi-label">Prom. Descarga (Pipa)</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Filtros -->
  <div class="filters">
    <div class="filter">
      <label>Ingenio</label>
      @await Html.PartialAsync("_IngenioSelect")
    </div>
    <div class="filter">
      <label>Producto</label>
      <select id="f-producto">
        <option value="" selected>Todos</option>
        <option value="AZ-001">Azúcar</option>
        <option value="MEL-001">Melaza</option>
      </select>
    </div>
    <div class="filter" style="align-self:flex-end;">
      <button id="f-apply" class="btn btn-primary">Aplicar</button>
    </div>
  </div>

  <!-- Charts 2×2 -->
  <div class="charts-grid">
    <section class="chart-card">
      <header>Camiones Finalizados</header>
      <div class="chart-scroll">
        @await Html.PartialAsync("_ChartEmptyOverlay")
        <div class="chart-inner">
          <canvas id="chart-finalizados"></canvas>
        </div>
      </div>
      <div class="legend">Tipo Camión:
        <p class="dot dot-blue"></p> Volteo
        <p class="dot dot-orange"></p> Plana
        <p class="dot dot-black"></p> Pipa
      </div>
    </section>

    <section class="chart-card">
      <header>Camiones Recibidos</header>
      <div class="chart-scroll">
        @await Html.PartialAsync("_ChartEmptyOverlay")
        <div class="chart-inner">
          <canvas id="chart-recibidos"></canvas>
        </div>
      </div>
      <div class="legend">Tipo Camión:
        <b class="dot dot-blue"></b> Volteo
        <b class="dot dot-orange"></b> Plana
        <b class="dot dot-black"></b> Pipa
      </div>
    </section>

    <section class="chart-card">
      <header>Cantidad Recibida</header>
      <div class="chart-scroll">
        @await Html.PartialAsync("_ChartEmptyOverlay")
        <div class="chart-inner">
          <canvas id="chart-azucar"></canvas>
        </div>
      </div>
      <div class="legend">Producto:
        <b class="dot dot-orange"></b> Azúcar
        <b class="dot dot-blue"></b> Melaza
      </div>
    </section>

    <section class="chart-card">
      <header>Promedio de Descarga</header>
      <div class="chart-scroll">
        @await Html.PartialAsync("_ChartEmptyOverlay")
        <div class="chart-inner">
          <canvas id="chart-promedio"></canvas>
        </div>
      </div>
      <div class="legend">Tipo Camión:
        <b class="dot dot-blue"></b> Volteo
        <b class="dot dot-orange"></b> Plana
        <b class="dot dot-black"></b> Pipa
      </div>
    </section>
  </div>
</div>
