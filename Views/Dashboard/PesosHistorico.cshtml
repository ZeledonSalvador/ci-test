@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" />
}

@await Html.PartialAsync("_DashSwitcher")
@await Html.PartialAsync("_Spinner")

<div class="dash-wrapper">

    <!-- ── Filtros ── -->
    <div class="filters">
        <div class="filter">
            <label>Fecha</label>
            <div class="date-range">
                <input type="date" id="f-desde" />
                <span>—</span>
                <input type="date" id="f-hasta" />
            </div>
        </div>
        <div class="filter">
            <label>Ingenio</label>
            <select id="f-ingenio">
                <option value="">Todos</option>
                <option value="JB">Ingenio Central Azucarero Jiboa</option>
                <option value="ILC">Ingenio La Cabaña</option>
                <option value="IEA">Ingenio El Angel</option>
                <option value="ILM">Ingenio La Magdalena</option>
                <option value="ICHP">Ingenio Chaparrastique</option>
                <option value="CASSA">Compañía Azucarera Salvadoreña</option>
            </select>
        </div>
        <div class="filter">
            <label>Producto</label>
            <select id="f-producto">
                <option value="" selected>Todos</option>
                <option value="AZ-001">Azúcar</option>
                <option value="MEL-001">Melaza</option>
            </select>
        </div>
        <div class="filter">
            <button id="f-apply" class="btn btn-primary">
                <i class="fas fa-search"></i> Aplicar
            </button>
        </div>
    </div>

    <!-- ── Indicadores Clave ── -->
    <div class="kpi-section">
        <div class="dash-section-label">Indicadores Clave</div>
        <div class="kpi-groups-row">

            <div class="kpi-group">
                <div class="kpi-group-grid">
                    <div class="kpi">
                        <div class="kpi-label">Cantidad Recibida de Azúcar</div>
                        <div class="kpi-value" id="kpi-cant-az">0 t</div>
                    </div>
                    <div class="kpi">
                        <div class="kpi-label">Cantidad Recibida de Melaza</div>
                        <div class="kpi-value" id="kpi-cant-mel">0 t</div>
                    </div>
                    <div class="kpi">
                        <div class="kpi-label">Cantidad Recibida (Volteo)</div>
                        <div class="kpi-value" id="kpi-cant-volteo">0 t</div>
                    </div>
                    <div class="kpi">
                        <div class="kpi-label">Cantidad Recibida (Planas)</div>
                        <div class="kpi-value" id="kpi-cant-planas">0 t</div>
                    </div>
                </div>
            </div>

            <div class="kpi-group">
                <div class="kpi-group-grid">
                    <div class="kpi">
                        <div class="kpi-label">Promedio de Humedad</div>
                        <div class="kpi-value" id="kpi-prom-humedad">0 %</div>
                    </div>
                    <div class="kpi">
                        <div class="kpi-label">Promedio de Brix</div>
                        <div class="kpi-value" id="kpi-prom-brix">0 °Bx</div>
                    </div>
                    <div class="kpi">
                        <div class="kpi-label">Promedio de Temperatura</div>
                        <div class="kpi-value" id="kpi-prom-temperatura">0 °C</div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- ── Tendencias ── -->
    <div class="charts-section">
        <div class="dash-section-label">Tendencias</div>
        <div class="charts-grid">

            <section class="chart-card">
                <header>Cantidad Recibida</header>
                <div class="chart-scroll">
                    @Html.Partial("_ChartEmptyOverlay")
                    <div class="chart-inner">
                        <canvas id="chart-total-kg"></canvas>
                    </div>
                </div>
                <div class="legend">Producto:
                    <b class="dot dot-orange"></b> Azúcar
                    <b class="dot dot-blue"></b> Melaza
                </div>
            </section>

            <section class="chart-card">
                <header>Cantidad Recibida Por Tipo de Camión</header>
                <div class="chart-scroll">
                    @Html.Partial("_ChartEmptyOverlay")
                    <div class="chart-inner">
                        <canvas id="chart-kg-por-tipo"></canvas>
                    </div>
                </div>
                <div class="legend">Tipo Camión:
                    <b class="dot dot-blue"></b> Volteo
                    <b class="dot dot-orange"></b> Plana
                    <b class="dot dot-black"></b> Pipa
                </div>
            </section>

            <section class="chart-card">
                <header>Promedio de Temperatura y Brix</header>
                <div class="chart-scroll">
                    @Html.Partial("_ChartEmptyOverlay")
                    <div class="chart-inner">
                        <canvas id="chart-prom-brix"></canvas>
                    </div>
                </div>
                <div class="legend">
                    <b class="dot dot-orange"></b> Brix
                    <b class="dot dot-blue"></b> Temperatura
                </div>
            </section>

            <section class="chart-card">
                <header>Promedio de Humedad</header>
                <div class="chart-scroll">
                    @Html.Partial("_ChartEmptyOverlay")
                    <div class="chart-inner">
                        <canvas id="chart-prom-humedad"></canvas>
                    </div>
                </div>
                <div class="legend">
                    <b class="dot dot-blue"></b> Humedad
                </div>
            </section>

        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2"></script>
    <script>
        (function () {
            const zoomPlugin = window['chartjs-plugin-zoom'] || window.ChartZoom;
            if (zoomPlugin) Chart.register(zoomPlugin);
        })();
    </script>
    <script src="~/js/dash-core.js?v=20260317"></script>
    <script src="~/js/dash-historico-pesos.js?v=20260317"></script>
}
