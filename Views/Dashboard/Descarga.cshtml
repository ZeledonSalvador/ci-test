@{
    ViewData["Title"] = "Dashboard - Tiempos / Gráficos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" />
}

@await Html.PartialAsync("_DashSwitcher")
@await Html.PartialAsync("_Spinner")

<div class="dash-wrapper">

    <!-- Filtros -->
    <div class="filters">
        <div class="filter">
            <label>Hora</label>
            <div class="date-range time-range">
                <select id="f-hour-start"></select>
                <span>–</span>
                <select id="f-hour-end"></select>
            </div>
        </div>

        <div class="filter">
            <label>Ingenio</label>
            @await Html.PartialAsync("_IngenioSelect")
        </div>

        <div class="filter">
            <label>Producto</label>
            <select id="f-producto">
                <option value="" selected>Todos</option>
                <option value="AZ-001">Azúcar</option>
                <option value="MEL-001">Melaza</option>
            </select>
        </div>

        <div class="filter">
            <button id="f-apply" class="btn btn-primary">
                <i class="fas fa-search"></i> Aplicar
            </button>
        </div>
    </div>

    <!-- KPIs -->
    <div class="kpi-section">
        <div class="dash-section-label">Indicadores Clave</div>
        <div class="kpi-groups-row">

            <!-- Grupo 1: unidades / tránsito / espera plana -->
            <div class="kpi-group">
                <div class="kpi-group-grid">
                    <div class="kpi">
                        <div class="kpi-label">Unidades Descargadas / Hora (Azúcar)</div>
                        <div class="kpi-value" id="kpi-cant-azucar">0</div>
                    </div>
                    <div class="kpi">
                        <div class="kpi-label">Unidades Descargadas / Hora (Melaza)</div>
                        <div class="kpi-value" id="kpi-cant-melaza">0</div>
                    </div>
                    <div class="kpi">
                        <div class="kpi-label">Tiempo Promedio a Planta (Azúcar)</div>
                        <div class="kpi-value" id="kpi-transito-azucar">0 min 00 s</div>
                    </div>
                    <div class="kpi">
                        <div class="kpi-label">Tiempo Promedio a Planta (Melaza)</div>
                        <div class="kpi-value" id="kpi-transito-melaza">0 min 00 s</div>
                    </div>
                    <div class="kpi">
                        <div class="kpi-label">Promedio de Espera (Plana)</div>
                        <div class="kpi-value" id="kpi-espera-plana">0 min 00 s</div>
                    </div>
                </div>
            </div>

            <!-- Grupo 2: espera volteo/pipa / descarga -->
            <div class="kpi-group">
                <div class="kpi-group-grid">
                    <div class="kpi">
                        <div class="kpi-label">Promedio de Espera (Volteo)</div>
                        <div class="kpi-value" id="kpi-espera-volteo">0 min 00 s</div>
                    </div>
                    <div class="kpi">
                        <div class="kpi-label">Promedio de Espera (Pipa)</div>
                        <div class="kpi-value" id="kpi-espera-pipa">0 min 00 s</div>
                    </div>
                    <div class="kpi">
                        <div class="kpi-label">Tiempo Promedio de Descarga (Plana)</div>
                        <div class="kpi-value" id="kpi-descarga-plana">0 min 00 s</div>
                    </div>
                    <div class="kpi">
                        <div class="kpi-label">Tiempo Promedio de Descarga (Volteo)</div>
                        <div class="kpi-value" id="kpi-descarga-volteo">0 min 00 s</div>
                    </div>
                    <div class="kpi">
                        <div class="kpi-label">Tiempo Promedio de Descarga (Pipa)</div>
                        <div class="kpi-value" id="kpi-descarga-pipa">0 min 00 s</div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Gráficos: uno por fila -->
    <div class="charts-section">
    <div class="dash-section-label">Tendencias</div>
    <div class="charts-grid--single one-col">

        <section class="chart-card">
            <header>Tiempo tránsito planta</header>
            <div class="chart-scroll chart-scrollH">
                @Html.Partial("_ChartEmptyOverlay")
                <div class="chart-inner">
                    <canvas id="chart-transito-placa"></canvas>
                </div>
            </div>
            <div class="legend"><span class="legend-title">Producto:</span>
                <b class="dot dot-orange"></b> Azúcar
                <b class="dot dot-blue"></b> Melaza
            </div>
        </section>

        <section class="chart-card">
            <header>Tiempo de espera</header>
            <div class="chart-scroll chart-scrollH">
                @Html.Partial("_ChartEmptyOverlay")
                <div class="chart-inner">
                    <canvas id="chart-espera-placa"></canvas>
                </div>
            </div>
            <div class="legend"><span class="legend-title">Tipo Camión:</span>
                <b class="dot dot-orange"></b> Plana
                <b class="dot dot-blue"></b> Volteo
                <b class="dot dot-black"></b> Pipa
            </div>
        </section>

        <section class="chart-card">
            <header>Tiempo de descarga</header>
            <div class="chart-scroll chart-scrollH">
                @Html.Partial("_ChartEmptyOverlay")
                <div class="chart-inner">
                    <canvas id="chart-descarga-placa"></canvas>
                </div>
            </div>
            <div class="legend"><span class="legend-title">Tipo Camión:</span>
                <b class="dot dot-orange"></b> Plana
                <b class="dot dot-blue"></b> Volteo
                <b class="dot dot-black"></b> Pipa
            </div>
        </section>

    </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2"></script>
    <script>
        (function () {
            const zoomPlugin = window['chartjs-plugin-zoom'] || window.ChartZoom;
            if (zoomPlugin) Chart.register(zoomPlugin);
            const s1 = document.getElementById("f-hour-start");
            const s2 = document.getElementById("f-hour-end");
            if (!s1 || !s2) return;

            const mkOpt = (h) => {
                const hh = String(h).padStart(2, "0");
                const o = document.createElement("option");
                o.value = `${hh}:00`;
                o.textContent = hh;
                return o;
            };

            for (let h = 0; h <= 23; h++) {
                s1.appendChild(mkOpt(h));
                s2.appendChild(mkOpt(h));
            }

            s1.value = "00:00";
            s2.value = "23:00";

            const clamp = () => {
                const a = Number((s1.value || "00:00").split(":")[0]);
                const b = Number((s2.value || "23:00").split(":")[0]);
                if (a > b) s2.value = s1.value;
            };
            s1.addEventListener("change", clamp);
            s2.addEventListener("change", clamp);
        })();
    </script>
    <script src="~/js/dash-core.js?v=20260316g"></script>
    <script src="~/js/dash-placas.js?v=20260315"></script>
}
